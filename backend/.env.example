# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# 生产环境可填写多个允许的前端 Origin，以英文逗号分隔。
CORS_ALLOWED_ORIGINS=
# 可填写完整 /play 地址；为空时使用 PUBLIC_PLAY_BASE_URL、PLAY_PAGE_BASE_URL、
# 启用的 self 主域名、PUBLIC_SHORTLINK_BASE_URL、FRONTEND_URL 的顺序兜底。
PLAY_PAGE_BASE_URL=
# 公共微信卡片页的根域名。配置后必须与域名池中已启用的 self 域名完全一致；
# 未配置时优先使用启用的 self 主域名，再按域名池 id 顺序选择其他 self 域名。
# 不一致会拒绝生成新链接，避免卡片域名与 /s 短链域名不一致。
PUBLIC_CARD_BASE_URL=
# 公共播放页根域名。优先级：PUBLIC_PLAY_BASE_URL > PLAY_PAGE_BASE_URL >
# 启用的 self 主域名 > PUBLIC_SHORTLINK_BASE_URL > FRONTEND_URL。
PUBLIC_PLAY_BASE_URL=
# 自建短链/客户访问域名的初始化兜底，仅在域名池没有启用 self 域名时供播放页配置使用；
# 新短链实际域名始终来自启用的 self 域名池，切换只影响之后生成的链接。
PUBLIC_SHORTLINK_BASE_URL=
# Nginx 到 Node 的代理层数，用于记录真实客户端 IP。
TRUST_PROXY_HOPS=1

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=video_ad_db
DB_CONNECTION_LIMIT=10

# Tencent Cloud VOD
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_APP_ID=your_tencent_app_id
TENCENT_VOD_REGION=ap-guangzhou
# 可选：默认分发配置中的 8-20 位播放密钥。留空时后端通过
# DescribeDefaultDistributionConfig 安全查询并短期缓存，不会输出密钥。
PLAYER_SIGN_KEY=

# Optional Tencent Cloud VOD settings
TENCENT_VOD_SUB_APP_ID=
TENCENT_PLAYER_LICENSE_URL=
TENCENT_UPLOAD_SIGNATURE_TTL_SECONDS=3600
TENCENT_PLAY_SIGNATURE_TTL_SECONDS=3600
TENCENT_VOD_API_TIMEOUT_MS=10000
TENCENT_VOD_API_MAX_RETRIES=2

# Video lifecycle
# 视频保留天数（默认 3 天，到期自动删除云端视频，访问统计数据保留）
VIDEO_RETENTION_DAYS=3
VIDEO_EXPIRY_SCAN_INTERVAL_MS=3600000

# Suolink
# API Key 与默认/首选域名也可以在后台“域名池管理”中选填；后台保存时会加密 API Key。
# 启用 Suolink 后，SUOLINK_DOMAIN 作为并列时首选；域名池中其他已启用且
# platform=suolink 的域名也会参与轮换。platform=self 的自建域名不会提交给 Suolink。
SUOLINK_API_BASE_URL=https://api.suolink.cn/api
SUOLINK_API_KEY=your_suolink_api_key
# 选填：缩链控制台中已绑定且生效的独享域名，作为默认/首选域名。
SUOLINK_DOMAIN=
SUOLINK_EXPIRE_DATE=
SUOLINK_STATS_API_URL=
SUOLINK_STATS_CODE_PARAM=shortCode
SUOLINK_API_TIMEOUT_MS=8000
SUOLINK_API_MAX_RETRIES=2
# 默认将服务商返回的 HTTP 短链升级为 HTTPS；独立域名没有证书时可临时设为 0。
SUOLINK_FORCE_HTTPS=1

# Cloudflare Worker short-link/OG layer (optional)
# 启用前先把 CLOUDFLARE_SHORTLINK_BASE_URL 作为 self 域名加入 demo18 域名池。
CLOUDFLARE_SHORTLINK_ENABLED=false
CLOUDFLARE_SHORTLINK_BASE_URL=https://s.hotwharf.com
CLOUDFLARE_SHORTLINK_API_URL=https://s.hotwharf.com
# 仅后端读取；对应 Worker API_KEYS KV 中的键，禁止配置到前端。
CLOUDFLARE_SHORTLINK_API_KEY=replace_with_worker_api_key
CLOUDFLARE_SHORTLINK_TIMEOUT_MS=5000
CLOUDFLARE_SHORTLINK_MAX_RETRIES=2
# 对应 Worker 的 DEMO18_SYNC_API_KEY secret，用于 Worker 点击回写。
WORKER_SYNC_API_KEY=replace_with_a_different_random_service_key

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
# 可选：专门用于加密后台保存的 API Key。未设置时使用 JWT_SECRET 派生密钥。
CONFIG_ENCRYPTION_KEY=
